# ─── Required Variables ───
BOT_TOKEN=your_bot_token_from_botfather
API_ID=your_api_id_from_my_telegram_org
API_HASH=your_api_hash_from_my_telegram_org
OWNER_ID=your_telegram_user_id
MONGO_DB=your_mongodb_connection_string

# ─── Optional Variables ───
FILES_CHANNEL=
BOT_NAME=Erika
# IMPORTANT: this must be a PYROGRAM-format session string, not a Telethon
# StringSession -- the two are not interchangeable. If you're upgrading from
# an older Telethon-based deployment of this bot, generate a fresh one, e.g.:
#
#   python3 -c "
#   from pyrogram import Client
#   with Client('gen', api_id=API_ID, api_hash='API_HASH') as app:
#       print(app.export_session_string())
#   "
#
# Used only for uploads over Telegram's 2GB bot-API limit; leave blank to
# always upload through the bot client instead.
SESSION_STRING=
TRIGGERS=/ !

# ─── Feature Variables ───
AUTO_AUTH=false
MAX_CONCURRENT=1
MAX_FILE_SIZE=0
DAILY_QUOTA=0
NOTIFICATION_CHANNEL=
WATERMARK_TEXT=
WATERMARK_IMAGE=
HW_ACCEL=auto
